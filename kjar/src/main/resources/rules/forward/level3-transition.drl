rule "FC L3 - Transition COUNTER_PRESS - pressing forwards"
    salience 18
    no-loop true

when
    TacticalAssistantInput( 
    teamProfile.attackType == AttackType.PRESSING_ATTACKERS
     )

    $facts : Level3Facts( 
    pressingIntensity == PressingIntensity.HIGH,
    transitionAfterLossOfBall == null
     )

then
    modify($facts) {
        setTransitionAfterLossOfBall( 
        TransitionAfterLossOfBall.COUNTER_PRESS
         ),
        addExplanationStep( TacticalExplanationFactory.transition( TransitionAfterLossOfBall.COUNTER_PRESS, "the forwards are suited to pressing and the team is already pressing high" ) )
    };

    System.out.println( "[FC:L3] transitionAfterLossOfBall=COUNTER_PRESS | reason=pressing attackers with high press" );

end


rule "FC L3 - Transition HOLD_SHAPE - counter opportunity with defensive mentality"
    salience 17
    no-loop true

when
    Level1Facts( 
    hasCounterOpportunity == true
     )

    Level2Facts( 
    selectedMentality == Mentality.DEFENSIVE
     )

    $facts : Level3Facts( 
    transitionAfterLossOfBall == null
     )

then
    modify($facts) {
        setTransitionAfterLossOfBall( 
        TransitionAfterLossOfBall.HOLD_SHAPE
         ),
        addExplanationStep( TacticalExplanationFactory.transition( TransitionAfterLossOfBall.HOLD_SHAPE, "the team can counter, but the mentality is protective, so structure matters" ) )
    };

    System.out.println( "[FC:L3] transitionAfterLossOfBall=HOLD_SHAPE | reason=counter opportunity with defensive mentality" );

end


