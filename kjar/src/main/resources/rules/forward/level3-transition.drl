rule "FC L3 - Transition REGROUP - low tactical fitness"
    salience 16
    no-loop true

when
    Level1Facts( 
    hasLowFitness == true
     )

    $facts : Level3Facts( 
    transitionAfterLossOfBall == null
     )

then
    modify($facts) {
        setTransitionAfterLossOfBall( 
