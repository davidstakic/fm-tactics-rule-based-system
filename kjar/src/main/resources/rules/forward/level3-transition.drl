package com.ftn.sbnz.kjar.rules.forward;

import com.ftn.sbnz.model.enums.AttackType;
import com.ftn.sbnz.model.enums.Mentality;
import com.ftn.sbnz.model.enums.PhysicalProfile;
import com.ftn.sbnz.model.enums.PressingIntensity;
import com.ftn.sbnz.model.enums.TransitionAfterLossOfBall;
import com.ftn.sbnz.model.forward.TacticalAssistantInput;
import com.ftn.sbnz.model.forward.Level1Facts;
import com.ftn.sbnz.model.forward.Level2Facts;
import com.ftn.sbnz.model.forward.Level3Facts;
import com.ftn.sbnz.model.forward.factory.TacticalExplanationFactory;


rule "FC L3 - Transition COUNTER_PRESS - balanced fast team"
    salience 20
    no-loop true

when
    Level2Facts( 
    selectedMentality == Mentality.BALANCED
     )

    TacticalAssistantInput( 
    teamProfile.physicalProfile == PhysicalProfile.FAST
     )

    $facts : Level3Facts( 
    transitionAfterLossOfBall == null
     )

then
    modify($facts) {
        setTransitionAfterLossOfBall( 
        TransitionAfterLossOfBall.COUNTER_PRESS
         ),
        addExplanationStep( TacticalExplanationFactory.transition( TransitionAfterLossOfBall.COUNTER_PRESS, "the team is balanced, quick, and can react immediately after losing possession" ) )
    };

    System.out.println( "[FC:L3] transitionAfterLossOfBall=COUNTER_PRESS | reason=balanced mentality with fast team" );

end


rule "FC L3 - Transition COUNTER_PRESS - attacking high press"
    salience 19
    no-loop true

when
    Level2Facts( 
    selectedMentality == Mentality.ATTACKING
     )

    $facts : Level3Facts( 
    pressingIntensity == PressingIntensity.HIGH,
    transitionAfterLossOfBall == null
     )

then
    modify($facts) {
        setTransitionAfterLossOfBall( 
        TransitionAfterLossOfBall.COUNTER_PRESS
         ),
        addExplanationStep( TacticalExplanationFactory.transition( TransitionAfterLossOfBall.COUNTER_PRESS, "the attacking mentality is already paired with high pressing" ) )
    };

    System.out.println( "[FC:L3] transitionAfterLossOfBall=COUNTER_PRESS | reason=attacking mentality with high press" );

end


