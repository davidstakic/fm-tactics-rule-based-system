rule "FC L3 - Transition REGROUP - default"
    salience 10

when
    $facts : Level3Facts( 
    transitionAfterLossOfBall == null
     )

then
    modify($facts) {
        setTransitionAfterLossOfBall( 
        TransitionAfterLossOfBall.REGROUP
         ),
        addExplanationStep( TacticalExplanationFactory.transition( TransitionAfterLossOfBall.REGROUP, "there is no strong reason to counter-press, so regrouping is the safer default" ) )
    };

    System.out.println( "[FC:L3] transitionAfterLossOfBall=REGROUP | reason=default" );

end
