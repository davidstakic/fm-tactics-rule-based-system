package com.ftn.sbnz.kjar.rules.forward;

import com.ftn.sbnz.model.enums.Mentality;
import com.ftn.sbnz.model.enums.MidfieldQuality;
import com.ftn.sbnz.model.enums.PassingDirectness;
import com.ftn.sbnz.model.enums.PlayingStyle;
import com.ftn.sbnz.model.forward.TacticalAssistantInput;
import com.ftn.sbnz.model.forward.Level1Facts;
import com.ftn.sbnz.model.forward.Level2Facts;
import com.ftn.sbnz.model.forward.Level3Facts;
import com.ftn.sbnz.model.forward.factory.TacticalExplanationFactory;


rule "FC L3 - Passing DIRECT - low tactical fitness"
    salience 30
    no-loop true

when
    Level1Facts( 
    hasLowFitness == true
     )

    $facts : Level3Facts(
    passingDirectness == null
     )

then
    modify($facts) {
        setPassingDirectness( PassingDirectness.DIRECT );
    };
    $facts.addExplanationStep(TacticalExplanationFactory.passing(PassingDirectness.DIRECT, "the team's tactical fitness is low, so a simpler and more direct route is safer"));
    update($facts);

    System.out.println("[FC:L3] passingDirectness=DIRECT | reason=low tactical fitness");

end


rule "FC L3 - Passing DIRECT - aggressive possession opponent"
    salience 29
    no-loop true

when
    Level1Facts( 
    isAggressiveOpponent == true
     )

    TacticalAssistantInput( 
    opponentProfile.playingStyle == PlayingStyle.POSSESSION_BASED
     )

    $facts : Level3Facts(
    passingDirectness == null
     )

then
    modify($facts) {
        setPassingDirectness( PassingDirectness.DIRECT );
    };
    $facts.addExplanationStep(TacticalExplanationFactory.passing(PassingDirectness.DIRECT, "the opponent presses aggressively and leaves space to attack quickly"));
    update($facts);

    System.out.println("[FC:L3] passingDirectness=DIRECT | reason=aggressive possession opponent");

end


rule "FC L3 - Passing DIRECT - counter opportunity with defensive mentality"
    salience 28
    no-loop true

when
    Level1Facts( 
    hasCounterOpportunity == true
     )

    Level2Facts( 
    selectedMentality == Mentality.DEFENSIVE
    ||
    selectedMentality == Mentality.CAUTIOUS
     )

    $facts : Level3Facts(
    passingDirectness == null
     )

then
    modify($facts) {
        setPassingDirectness( PassingDirectness.DIRECT );
    };
    $facts.addExplanationStep(TacticalExplanationFactory.passing(PassingDirectness.DIRECT, "there is space to counter and the selected mentality is more protective"));
    update($facts);

    System.out.println("[FC:L3] passingDirectness=DIRECT | reason=counter opportunity with defensive mentality");

end


rule "FC L3 - Passing SHORTER - creative midfield and good fitness"
    salience 27
    no-loop true

when
    TacticalAssistantInput( 
    teamProfile.midfieldQuality == MidfieldQuality.CREATIVE
     )

    Level1Facts( 
    hasHighFitness == true
     )

    Level2Facts( 
    selectedMentality == Mentality.POSITIVE
    ||
    selectedMentality == Mentality.ATTACKING
     )

    $facts : Level3Facts(
    passingDirectness == null
     )

then
    modify($facts) {
        setPassingDirectness( PassingDirectness.SHORTER );
    };
    $facts.addExplanationStep(TacticalExplanationFactory.passing(PassingDirectness.SHORTER, "the midfield is creative, the team is fit, and the mentality supports proactive possession"));
    update($facts);

    System.out.println("[FC:L3] passingDirectness=SHORTER | reason=creative midfield and good fitness");

end


rule "FC L3 - Passing SHORTER - passive opponent"
    salience 26
    no-loop true

when
    Level1Facts( 
    isPassiveOpponent == true
     )

    TacticalAssistantInput( 
    teamProfile.midfieldQuality == MidfieldQuality.CREATIVE
     )

    $facts : Level3Facts(
    passingDirectness == null
     )

then
    modify($facts) {
        setPassingDirectness( PassingDirectness.SHORTER );
    };
    $facts.addExplanationStep(TacticalExplanationFactory.passing(PassingDirectness.SHORTER, "a passive opponent can be moved around through patient combinations"));
    update($facts);

    System.out.println("[FC:L3] passingDirectness=SHORTER | reason=creative midfield against passive opponent");

end


rule "FC L3 - Passing STANDARD - default"
    salience 10

when
    $facts : Level3Facts( 
    passingDirectness == null
     )

then
    modify($facts) {
        setPassingDirectness( PassingDirectness.STANDARD );
    };
    $facts.addExplanationStep(TacticalExplanationFactory.passing(PassingDirectness.STANDARD, "there is no strong reason to force a very short or very direct passing style"));
    update($facts);

    System.out.println("[FC:L3] passingDirectness=STANDARD | reason=default");

end
