package com.ftn.sbnz.kjar.rules.forward;

import com.ftn.sbnz.model.enums.DefensiveLineHeight;
import com.ftn.sbnz.model.enums.Mentality;
import com.ftn.sbnz.model.forward.TacticalAssistantInput;
import com.ftn.sbnz.model.forward.Level1Facts;
import com.ftn.sbnz.model.forward.Level2Facts;
import com.ftn.sbnz.model.forward.Level3Facts;
import com.ftn.sbnz.model.forward.factory.TacticalExplanationFactory;


rule "FC L3 - Defensive line LOW - no high-line capability"
    salience 30
    no-loop true

when
    TacticalAssistantInput( 
    teamProfile.highLineCapability == false
     )

    $facts : Level3Facts( 
    defensiveLineHeight == null
     )

then
    modify($facts) {
        setDefensiveLineHeight( DefensiveLineHeight.LOW );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.defensiveLine( DefensiveLineHeight.LOW, "the team is not well suited to holding a high defensive line" ) );
    update($facts);

    System.out.println( "[FC:L3] defensiveLineHeight=LOW | reason=no high-line capability" );

end


rule "FC L3 - Defensive line LOW - cautious mentality"
    salience 29
    no-loop true

when
    Level2Facts( 
