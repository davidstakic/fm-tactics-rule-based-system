rule "FC L3 - Defensive line HIGH - positive without counter threat"
    salience 27
    no-loop true

when
    TacticalAssistantInput( 
    teamProfile.highLineCapability == true
     )

    Level2Facts( 
    selectedMentality == Mentality.POSITIVE
     )

    Level1Facts( 
    hasCounterOpportunity == false
     )

    $facts : Level3Facts( 
    defensiveLineHeight == null
     )

then
    modify($facts) {
        setDefensiveLineHeight( DefensiveLineHeight.HIGH );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.defensiveLine( DefensiveLineHeight.HIGH, "the team can defend higher and there is no strong counter threat" ) );
    update($facts);

    System.out.println( "[FC:L3] defensiveLineHeight=HIGH | reason=positive mentality without counter threat" );

end


rule "FC L3 - Defensive line STANDARD - counter threat"
    salience 26
    no-loop true

when
    TacticalAssistantInput( 
    teamProfile.highLineCapability == true
     )

    Level1Facts( 
    hasCounterOpportunity == true
     )

    $facts : Level3Facts( 
    defensiveLineHeight == null
     )

then
    modify($facts) {
        setDefensiveLineHeight( DefensiveLineHeight.STANDARD );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.defensiveLine( DefensiveLineHeight.STANDARD, "the opponent has counter-attacking space, so the line should not be too high" ) );
    update($facts);

    System.out.println( "[FC:L3] defensiveLineHeight=STANDARD | reason=counter threat" );

end


