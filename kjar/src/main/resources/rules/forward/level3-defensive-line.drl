    defensiveLineHeight == null
     )

then
    modify($facts) {
        setDefensiveLineHeight( DefensiveLineHeight.LOW );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.defensiveLine( DefensiveLineHeight.LOW, "the selected mentality asks the team to stay compact and protect space" ) );
    update($facts);

    System.out.println( "[FC:L3] defensiveLineHeight=LOW | reason=cautious mentality" );

end


