rule "FC L3 - Pressing HIGH - positive with pressing forwards"
    salience 29
    no-loop true

when
    Level2Facts( 
    selectedMentality == Mentality.POSITIVE
     )

    TacticalAssistantInput( 
    teamProfile.attackType == AttackType.PRESSING_ATTACKERS
     )

    $facts : Level3Facts( 
    pressingIntensity == null
     )

then
    modify($facts) {
        setPressingIntensity( PressingIntensity.HIGH );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.pressing( PressingIntensity.HIGH, "the team has forwards suited to pressing and the mentality is positive" ) );
    update($facts);

    System.out.println( "[FC:L3] pressingIntensity=HIGH | reason=positive mentality with pressing attackers" );

end


rule "FC L3 - Pressing MEDIUM - positive without pressing forwards"
    salience 28
    no-loop true

when
    Level2Facts( 
    selectedMentality == Mentality.POSITIVE
     )

    TacticalAssistantInput( 
    teamProfile.attackType != AttackType.PRESSING_ATTACKERS
     )

    $facts : Level3Facts( 
    pressingIntensity == null
     )

then
    modify($facts) {
        setPressingIntensity( PressingIntensity.MEDIUM );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.pressing( PressingIntensity.MEDIUM, "the mentality is positive, but the attack is not built around constant forward pressing" ) );
    update($facts);

    System.out.println( "[FC:L3] pressingIntensity=MEDIUM | reason=positive mentality without pressing attackers" );

end


rule "FC L3 - Pressing MEDIUM - balanced fast team"
