    teamProfile.physicalProfile == PhysicalProfile.FAST
     )

    $facts : Level3Facts( 
    pressingIntensity == null
     )

then
    modify($facts) {
        setPressingIntensity( PressingIntensity.MEDIUM );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.pressing( PressingIntensity.MEDIUM, "a balanced mentality and fast players allow useful pressure without overcommitting" ) );
    update($facts);

    System.out.println( "[FC:L3] pressingIntensity=MEDIUM | reason=balanced mentality with fast team" );

end


rule "FC L3 - Pressing LOW - balanced non-fast team"
    salience 26
    no-loop true

when
    Level2Facts( 
    selectedMentality == Mentality.BALANCED
     )

    TacticalAssistantInput( 
    teamProfile.physicalProfile != PhysicalProfile.FAST
     )

    $facts : Level3Facts( 
    pressingIntensity == null
     )

then
    modify($facts) {
        setPressingIntensity( PressingIntensity.LOW );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.pressing( PressingIntensity.LOW, "the team does not have a clear pace advantage, so compactness is safer" ) );
    update($facts);

    System.out.println( "[FC:L3] pressingIntensity=LOW | reason=balanced mentality without pace advantage" );

end


