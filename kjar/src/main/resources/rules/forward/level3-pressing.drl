package com.ftn.sbnz.kjar.rules.forward;

import com.ftn.sbnz.model.enums.AttackType;
import com.ftn.sbnz.model.enums.Mentality;
import com.ftn.sbnz.model.enums.PhysicalProfile;
import com.ftn.sbnz.model.enums.PressingIntensity;
import com.ftn.sbnz.model.forward.TacticalAssistantInput;
import com.ftn.sbnz.model.forward.Level1Facts;
import com.ftn.sbnz.model.forward.Level2Facts;
import com.ftn.sbnz.model.forward.Level3Facts;
import com.ftn.sbnz.model.forward.factory.TacticalExplanationFactory;


rule "FC L3 - Pressing HIGH - very attacking mentality"
    salience 30
    no-loop true

when
    Level2Facts( 
    selectedMentality == Mentality.VERY_ATTACKING
     )

    $facts : Level3Facts( 
    pressingIntensity == null
     )

then
    modify($facts) {
        setPressingIntensity( PressingIntensity.HIGH );
    };
    $facts.addExplanationStep( TacticalExplanationFactory.pressing( PressingIntensity.HIGH, "the selected mentality is aggressive and supports early pressure" ) );
    update($facts);

    System.out.println( "[FC:L3] pressingIntensity=HIGH | reason=very attacking mentality" );

end


rule "FC L3 - Pressing HIGH - attacking mentality"
