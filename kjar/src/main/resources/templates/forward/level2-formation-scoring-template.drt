template header
input_conditions
fact_conditions
formation_group
number_of_points
description

package com.ftn.sbnz.kjar.rules.forward;

import java.util.List;
import com.ftn.sbnz.model.enums.AttackType;
import com.ftn.sbnz.model.enums.MidfieldQuality;
import com.ftn.sbnz.model.forward.TacticalAssistantInput;
import com.ftn.sbnz.model.forward.FormationScore;
import com.ftn.sbnz.model.forward.Level1Facts;

template "Level 2 Formation scoring"

rule "FC L2 - Formation score - @{description}"
salience 60
no-loop true

when
    $input : TacticalAssistantInput(
        @{input_conditions}
    )

    $facts : Level1Facts(
        @{fact_conditions}
    )

    not String(this == "formation-scoring:@{description}")

    $scores : List()
        from collect(FormationScore())

then

    String[] formations = new String[] { @{formation_group} };

    for (String formation : formations) {

            for (Object obj : $scores) {

                FormationScore score = (FormationScore) obj;

                if (score.getFormation().name().equals(formation)) {

                    score.addScore(
                        "@{description}",
                        @{number_of_points}
                    );

                    update(score);

                    break;
                }
            }
    }

    insert("formation-scoring:@{description}");

    System.out.println(
        "[FC:L2] formationScoreDelta=@{number_of_points}"
        + " | formations=" + java.util.Arrays.toString(formations)
        + " | reason=@{description}"
    );

end

end template
