template header
condition
formation_group
number_of_points
description

package com.ftn.sbnz.kjar.rules;

import com.ftn.sbnz.model.TacticalAssistantInput;
import com.ftn.sbnz.model.BasicTacticalSettings;
import com.ftn.sbnz.model.FormationScore;

template "Level 2 Formation scoring"

rule "2_scoring_@{description}"
salience 50

when
    $input : TacticalAssistantInput(
        @{condition}
    )

    $scores : List()
        from collect(FormationScore())

then

    String[] formations = new String[] { @{formation_group} };

    for (String formation : formations) {

        boolean found = false;

        for (Object obj : $scores) {

            FormationScore score = (FormationScore) obj;

            if (score.getFormation().name().equals(formation)) {

                score.addScore(
                    "@{description}",
                    @{number_of_points}
                );

                update(score);

                found = true;

                break;
            }
        }

        if (!found) {

            FormationScore newScore =
                new FormationScore(
                    BasicTacticalSettings.Formation.valueOf(
                        formation
                    )
                );

            newScore.addScore(
                "@{description}",
                @{number_of_points}
            );

            insert(newScore);
        }
    }

end

end template