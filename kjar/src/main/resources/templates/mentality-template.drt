template header
conditions
blocking_flags
mentality
priority
description

package com.ftn.sbnz.kjar.rules;

import com.ftn.sbnz.model.enums.Mentality;
import com.ftn.sbnz.model.forward.TacticalAssistantInput;
import com.ftn.sbnz.model.forward.Level1Facts;
import com.ftn.sbnz.model.forward.Level2Facts;

template "Level 2 Choosing mentality"

rule "2_mentality_@{mentality}_@{priority}"
salience @{priority}
no-loop true

when

    $input : TacticalAssistantInput()

    $facts : Level1Facts(
        @{conditions}
        @{blocking_flags}
    )

    $existing : Level2Facts(
        selectedMentality == null
    )

then

    modify($existing) {
        setSelectedMentality(
            Mentality.@{mentality}
        );
    };

    System.out.println(
        "[LEVEL 2] Mentality = @{mentality}"
        + " (priority: @{priority})"
        + " - @{description}"
    );

end

end template
