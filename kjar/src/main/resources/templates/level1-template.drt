template header
parameter
operator
value
flag_name

package com.ftn.sbnz.kjar.rules;

import com.ftn.sbnz.model.TacticalAssistantInput;
import com.ftn.sbnz.model.MatchContext.LocationType;
import com.ftn.sbnz.model.MatchContext.MatchImportance;
import com.ftn.sbnz.model.MatchContext.CompetitionType;
import com.ftn.sbnz.model.OpponentProfile.OpponentWeakness;
import com.ftn.sbnz.model.OpponentProfile.DefenseLineEngagement;
import com.ftn.sbnz.model.OpponentProfile.PlayingStyle;
import com.ftn.sbnz.model.Level1Facts;

function int countWinsInForm(String formLast5Matches) {
    if (formLast5Matches == null || formLast5Matches.trim().isEmpty()) {
        return 0;
    }

    int wins = 0;
    for (String result : formLast5Matches.split("-")) {
        if ("W".equals(result.trim())) {
            wins++;
        }
    }
    return wins;
}

template "Level 1 Facts"

rule "1_@{flag_name}"
salience 100
no-loop true

when
    $input : TacticalAssistantInput(
        @{parameter} @{operator} @{value}
    )

    $facts : Level1Facts()

then
    modify($facts) {
        set@{flag_name}(true)
    };

    System.out.println("[LEVEL 1] @{flag_name} = true");

end

end template